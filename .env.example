# Токен вашего Telegram бота (получить в @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID или юзернейм канала для публикации анкет
# ВНИМАНИЕ: Бот обязательно должен быть администратором канала с правом публикации сообщений!
# Для публичного канала: @your_channel_name
# Для приватного канала: -1001234567890
CHANNEL_ID=@your_channel_name

# Название файла базы данных SQLite
DB_NAME=bot.db
